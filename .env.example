# === Compose Video Editor - Environment Variables ===

# Storage mode: "local" or "r2"
STORAGE_MODE=local

# Cloudflare R2 (only needed if STORAGE_MODE=r2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=compose-media
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Anthropic API (Claude Haiku for edit planning)
ANTHROPIC_API_KEY=

# Pexels API (b-roll stock video + overlay photos)
PEXELS_API_KEY=

# Logo.dev (brand/org logo overlays — set in Railway service variables)
LOGO_DEV_SECRET_KEY=
LOGO_DEV_PUBLISHABLE_KEY=

# Asset selection: overlay source and CLIP ranking
OVERLAY_SOURCE_PRIMARY=pexels
OVERLAY_SOURCE_FALLBACK_AI=true
CLIP_ENABLED=true
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
CLIP_DEVICE=cpu
CLIP_QUERY_VARIANTS=4
CLIP_CANDIDATES_PER_VARIANT=6
CLIP_FRAMES_PER_VIDEO=3
CLIP_MAX_CONCURRENT_DOWNLOADS=4
CLIP_MAX_CONCURRENT_VIDEO_EXTRACTS=2
CLIP_HTTP_TIMEOUT_S=2.5
CLIP_HTTP_RETRY=1
CLIP_TARGET_ASPECT=9:16

# Database
DATABASE_URL=postgresql://compose:compose@postgres:5432/compose

# Redis
REDIS_URL=redis://redis:6379/0

# App
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
SECRET_KEY=dev-secret-change-me

# CORS — comma-separated origins allowed to call the API
# Use "*" for development, set to your Vercel domain in production
# e.g. https://compose-web.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=*

# Port — Railway injects this automatically; default 8000 for local dev
PORT=8000

# Whisper
WHISPER_MODEL=base

# Local storage path (when STORAGE_MODE=local)
LOCAL_STORAGE_PATH=/data/storage
